# SupportPearlz Environment Configuration Example
# Copy this file to .env and configure your local settings.
# NEVER commit your actual .env file or API keys to version control.

# --- LLM Provider Selection ---
# Options: 'google_genai', 'openai', or 'mock'
LLM_PROVIDER=google_genai

# Chat model name (e.g., 'gemini-1.5-flash', 'gemini-1.5-pro', 'gpt-4o-mini', 'gpt-4o')
LLM_MODEL=gemini-1.5-flash

# Sampling temperature (must be set explicitly low, 0.0 recommended for factual RAG)
TEMPERATURE=0.0

# --- Text Embedding Selection ---
# Options: 'google_genai', 'openai', or 'chroma_default'
EMBEDDING_PROVIDER=chroma_default

# Embedding model identifier (e.g. 'models/text-embedding-004', 'text-embedding-3-small')
EMBEDDING_MODEL=text-embedding-004

# --- API Keys ---
# Google Gemini API key (required if LLM_PROVIDER=google_genai or EMBEDDING_PROVIDER=google_genai)
GOOGLE_API_KEY=your_gemini_api_key_here

# OpenAI API key (required if LLM_PROVIDER=openai or EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# --- Vector Store & Ingestion Tunables ---
# Target directory for persisted vector store index on disk
VECTOR_STORE_DIR=data/vector_store

# Vector store collection name
COLLECTION_NAME=pearlz_kb

# Chunking character length (experimented: 300, 800, 1500)
CHUNK_SIZE=800

# Chunk overlap in characters (15% of chunk size recommended)
CHUNK_OVERLAP=120

# --- Retrieval Tunables ---
# Top-k retrieved chunks passed to relevance gate and prompt
RETRIEVAL_K=4

# Relevance gate cosine similarity threshold (rejection if best score < threshold)
SCORE_THRESHOLD=0.35

# Retriever search type: 'similarity', 'mmr', or 'similarity_score_threshold'
SEARCH_STRATEGY=similarity

# Maximum characters of retrieved context injected into prompt
MAX_CONTEXT_CHARS=6000

# Number of past conversation turns retained in memory window
MEMORY_WINDOW_TURNS=5

# --- Central Logging ---
# Logging level: 'DEBUG', 'INFO', 'WARNING', 'ERROR'
LOG_LEVEL=INFO
